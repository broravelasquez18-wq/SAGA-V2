# Servir archivos como descarga/estáticos, nunca ejecutar scripts
php_flag engine off
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .pht
RemoveType .php .phtml .php3 .php4 .php5 .php7 .pht
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht|cgi|pl|py|sh|asp|aspx)$">
    Require all denied
</FilesMatch>
