# ---------------------------------------------------------------------------
# Configuración del Verificador OCR. Copia este archivo a `.env` y complétalo.
# NUNCA subas el .env real al repositorio (está en .gitignore).
# ---------------------------------------------------------------------------

# Base de datos MySQL
DB_HOST=db
DB_PORT=3306
DB_NAME=verificador
DB_USER=verificador
DB_PASS=cambia_esta_clave

# Credenciales root de MySQL (solo las usa docker-compose para inicializar el contenedor)
DB_ROOT_PASS=cambia_esta_clave_root

# Entorno de la aplicación: dev | prod
APP_ENV=dev

# Ruta al intérprete de Python que ejecuta el OCR (dentro del contenedor es python3)
OCR_PYTHON_BIN=python3

# Tamaño máximo de imagen aceptada en el endpoint de OCR (bytes). 15 MB por defecto.
OCR_MAX_UPLOAD_BYTES=15728640
