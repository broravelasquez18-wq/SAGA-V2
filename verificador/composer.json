{
    "name": "saga/verificador",
    "description": "Verificador de documentación por OCR (cruce de lista de inscritos SENA contra cédulas escaneadas).",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "phpoffice/phpspreadsheet": "^2.0 || ^3.0 || ^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
